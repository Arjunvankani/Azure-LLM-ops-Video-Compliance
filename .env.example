AZURE_VI_ACCOUNT_ID=your_video_indexer_account_id
AZURE_VI_LOCATION=trial
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_VI_NAME=your_video_indexer_name

APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your_key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# Optional local app config
PYTHONPATH=.
